<%@ Master Language="VB" CodeFile="plantilla.master.vb" Inherits="plantilla" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title></title>
    <link href="css/styles.css" rel="stylesheet" />
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header class="topbar">
            <div class="logo">Pomalca</div>
            <div class="system-title">SISTEMA DE GESTIÓN</div>
            <div class="user-info">
                <asp:Button ID="btnMCerrarSesion" runat="server" CssClass="logout-btn" Text="Cerrar sesión" />
            </div>
        </header>
        <div class="layout">
            <aside class="sidebar">
                <ul>
                    <li>
                        <asp:LinkButton ID="btnMInicio" runat="server" Text="Inicio" />
                    </li>
                    <li>
                        <asp:LinkButton ID="btnMPersonal" runat="server" Text="Gestión de Usuarios" />
                    </li>
                    <li>
                        <asp:LinkButton ID="btnMModificar" runat="server" Text="Modificar Contraseña" />
                    </li>
                    <li>
                        <asp:LinkButton ID="btnMIniciarSesion" runat="server" Text="Iniciar Sesión" />
                    </li>
                </ul>
            </aside>
            <main class="main-content">
                <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>
</body>
</html>
